rules_version = '2';

// HoneyBee Firestore Security Rules
//
// IMPORTANT: These rules allow unrestricted read/write access because
// the app uses client-side authentication (not Firebase Auth).
//
// To deploy:
//   1. Install Firebase CLI:  npm install -g firebase-tools
//   2. Login:                  firebase login
//   3. Deploy rules:           firebase deploy --only firestore:rules
//
// Or paste this content directly into the Firebase Console:
//   Console → Firestore Database → Rules tab → paste → Publish
//
// For production, integrate Firebase Auth and tighten rules:
//   allow read, write: if request.auth != null;

service cloud.firestore {
  match /databases/{database}/documents {

    // User registry — profiles, passwords, referral codes
    match /users/{userId} {
      allow read, write: if true;
    }

    // Per-user data — balance, tasks, deposits, withdrawals, etc.
    match /userData/{userId} {
      allow read, write: if true;
    }
  }
}
